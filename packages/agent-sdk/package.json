{
  "name": "@mission-control/agent-sdk",
  "version": "1.0.0",
  "description": "SDK for agents to report status to Mission Control",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.1",
    "typescript": "~5.3.0"
  },
  "keywords": [
    "agent",
    "monitoring",
    "sdk"
  ],
  "license": "MIT"
}
